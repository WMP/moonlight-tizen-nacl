<?xml version="1.0" encoding="utf-8"?>
<!-- PROVISIONAL dotnet app manifest for the no-root dev-cert path. Verify
     api-version, privileges and appid conventions against the installed
     dev.moonlight.tvshell on the TV. -->
<manifest xmlns="http://tizen.org/ns/packages" api-version="5.0" package="org.moonlight.host" version="0.0.1">
    <profile name="tv"/>
    <ui-application appid="org.moonlight.host.app" exec="MoonlightHost.dll" type="dotnet"
                   multiple="false" nodisplay="false" taskmanage="true" launch_mode="single">
        <label>Moonlight</label>
        <icon>icon.png</icon>
        <metadata key="http://tizen.org/metadata/prefer_dotnet_aot" value="true"/>
    </ui-application>
    <privileges>
        <privilege>http://tizen.org/privilege/internet</privilege>
        <privilege>http://tizen.org/privilege/network.get</privilege>
        <privilege>http://tizen.org/privilege/display</privilege>
        <privilege>http://tizen.org/privilege/mediastorage</privilege>
    </privileges>
</manifest>
