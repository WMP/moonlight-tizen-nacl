<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PROVISIONAL. Tizen 5.0 TVs run an older .NET (Tizen.NET 5.x / .NET Core 2.1-era),
    not net6+. Before building, read the TFM + runtime the WORKING on-device app
    `dev.moonlight.tvshell` targets and MATCH it (see ../DEV-CERT-PATH.md). Using a
    too-new TFM produces a .tpk the TV's dotnet-launcher cannot run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen50</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tizen.NET API for Tizen 5.0. Pin the version that matches the device. -->
    <PackageReference Include="Tizen.NET" Version="5.0.0.14629" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native engine shipped inside the tpk under lib/ and dlopen'd by P/Invoke.
         build-engine-so.sh produces it; copy it to lib/ before packing. -->
    <None Include="lib/libmlengine.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>lib/libmlengine.so</Link>
    </None>
  </ItemGroup>
</Project>
